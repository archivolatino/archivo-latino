{
	"name": "archivo-latino",
	"main": "worker.js",
	"compatibility_date": "2026-09-01",
	"observability": {"enabled": true},
	"d1_databases": [
		{"binding": "SIGNUPS", "database_name": "archivo-latino-signups", "database_id": "a4ccdf8d-1dbb-4c6f-8fc7-202e0ab129ee"}
	],

	"vars": {
		"ALLOWED_ORIGINS": "https://archivolatino.org,https://www.archivolatino.org,https://archivolatino.github.io",
		"NOTIFY_TO": "info@archivolatino.com",
		// who the notification comes from. its domain has to be verified in resend (domains), or resend
		// refuses to send. the part in front of the brackets is the name inboxes show
		"NOTIFY_FROM": "Archivo Latino <info@archivolatino.org>"
	}
}
